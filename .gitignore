node_modules
dist
dist-ssr
*.local
*.tsbuildinfo

# js-dos engine assets - regenerated from node_modules by
# scripts/setup-jsdos-assets.mjs (postinstall/predev/prebuild), not
# committed since they're build artifacts, not authored content.
public/js-dos

# Retrocade's libretro cores - downloaded by
# scripts/setup-nostalgist-assets.mjs (postinstall/predev/prebuild), same
# reasoning as public/js-dos above.
public/nostalgist

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Tauri (Rust)
src-tauri/target
# Auto-regenerated by the Tauri CLI for capability schema autocompletion
src-tauri/gen/schemas

# Updater signing keys - never commit the private half (see README's
# "Releasing & auto-updates"). Only the public key belongs in tauri.conf.json.
*.key
*.key.pub
