{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JESSPR-EAST",
  "version": "0.9.0",
  "identifier": "dev.jesspreast.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JESSPR-EAST",
        "width": 1280,
        "height": 900,
        "minWidth": 400,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2N0QyRkRCQ0E4NjlFREIKUldUYm5vYksyeTk5OXY1N05tQklMYkFKcWZETm1wTGJDNlZEd2RpOGE3OVk1RzIxWkpPYzZ6TnMK",
      "endpoints": [
        "https://github.com/krakercode/CS-idea/releases/latest/download/latest.json"
      ]
    }
  }
}
